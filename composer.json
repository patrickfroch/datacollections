{
    "name": "patrickfroch/datacollections",
    "description": "Es handelt sich um eine Erweiterung für das Open Source CMS Contao. Die Software stellt zwei Collections zur Verfügung und ist als Ersatz für den Einsatz für Arrays gedacht.",
    "license": "LGPL-3.0-or-later",
    "type": "contao-bundle",
    "authors": [
        {
            "name": "Patrick Froch",
            "email": "hallo@patrick-froch.de",
            "homepage": "https://patrick-froch.de",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "hallo@patrick-froch.de",
        "issues": "https://github.com/patrickfroch/datacollections/issues",
        "docs": "https://github.com/patrickfroch/datacollections/blob/main/README.md"
    },
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.0",
        "patrickfroch/databaselayer": "^2.0",
        "patrickfroch/valueobjects": "^2.0"
    },
    "require-dev": {
        "contao/test-case": "^5.3",
        "phpunit/phpunit": "^9.5|^12.0",
        "phpstan/phpstan": "^2.1",
        "symplify/easy-coding-standard": "^13.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Esit\\Datacollections\\": ""
        }
    },
    "extra": {
        "contao-manager-plugin": "Esit\\Datacollections\\Classes\\Contao\\Manager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": true,
            "php-http/discovery": true
        }
    }
}
